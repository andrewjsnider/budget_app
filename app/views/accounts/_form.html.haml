= form_with model: @account, data: { turbo: false }, local: true do |f|
  %div{ class: "space-y-4" }
    %div
      = f.label :name, class: "ui-label"
      = f.text_field :name, class: "mt-1 w-full"

    %div
      = f.label :kind, class: "ui-label"
      = f.select :kind,
        [["Checking", "checking"], ["Savings", "savings"], ["Credit Card", "credit"], ["Cash", "cash"]],
        {},
        class: "mt-1 w-full"

    %div
      = f.label :import_key, "Statement import key", class: "ui-label"
      = f.text_field :import_key,
        placeholder: "primary-checking",
        autocapitalize: "none",
        autocomplete: "off",
        class: "mt-1 w-full font-mono"
      %p{ class: "ui-help" }
        Required for active accounts. Use lowercase letters, numbers, and hyphens. It cannot be changed after a statement is staged.

    - if f.object.persisted?
      %div
        %label{ class: "inline-flex items-center gap-2 text-sm" }
          = f.check_box :archived
          Archived

  %div{ class: "mt-6 flex gap-3 items-center" }
    = f.submit f.object.persisted? ? "Save" : "Create",
      class: "ui-button-primary"
    = link_to "Cancel", accounts_path, class: "ui-button-secondary"
