%div{ class: "ui-page" }
  %div{ class: "ui-page-header" }
    %div
      %h1{ class: "ui-title" } Accounts
      %p{ class: "ui-subtitle" } Active accounts only.
    = link_to "New account", new_account_path, class: "ui-button-primary"

  %div{ class: "ui-table-wrap mt-6" }
    %table{ class: "ui-table" }
      %thead
        %tr{ class: "border-b border-stone-200" }
          %th{ class: "p-3 text-left" } Name
          %th{ class: "p-3 text-left" } Kind
          %th{ class: "p-3 text-left" } Import key
          %th{ class: "p-3 text-right" } Actions
      %tbody
        - @accounts.each do |account|
          %tr{ class: "border-t border-stone-200" }
            %td{ class: "font-medium" }= link_to account.name, account_path(account), class: "ui-link"
            %td= status_badge(account.kind.to_s.humanize, tone: :neutral)
            %td{ class: "font-mono text-xs text-stone-600" }= account.import_key.presence || "Not set"
            %td{ class: "ui-cell-action" }
              = link_to 'Edit', edit_account_path(account), class: 'ui-link text-sm'
