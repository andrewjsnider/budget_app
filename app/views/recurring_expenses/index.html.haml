%div{ class: "ui-page" }
  %div{ class: "ui-page-header" }
    %h1{ class: "ui-title" } Recurring expenses
    = link_to "New recurring expense", new_recurring_expense_path, class: "ui-button-primary"

  %div{ class: "ui-table-wrap mt-6" }
    %table{ class: "ui-table" }
      %thead
        %tr{ class: "border-b border-stone-200" }
          %th{ class: "p-3 text-left" } Name
          %th{ class: "p-3 text-left" } Category
          %th{ class: "p-3 text-left" } Account
          %th{ class: "p-3 text-left" } Cadence
          %th{ class: "p-3 text-left" } Status
          %th{ class: "p-3 text-right" } Amount
          %th{ class: "p-3 text-right" }
      %tbody
        - @recurring_expenses.each do |r|
          %tr{ class: "border-t border-stone-200" }
            %td{ class: "font-medium" }= r.name
            %td{ class: "text-stone-600" }= r.category&.name
            %td{ class: "text-stone-600" }= r.account&.name
            %td{ class: "text-stone-600" }= r.cadence.to_s.humanize
            %td= status_badge(r.active? ? "Active" : "Inactive", tone: r.active? ? :positive : :neutral)
            %td{ class: "ui-cell-number" }= number_to_currency(r.estimated_amount_cents.to_i / 100.0)
            %td{ class: "ui-cell-action" }= link_to "Edit", edit_recurring_expense_path(r), class: "ui-link text-sm"
