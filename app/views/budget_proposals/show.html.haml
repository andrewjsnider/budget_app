- payload = @proposal.proposal
- monthly_income = payload["paycheck_income_monthly_totals_cents"] || payload["recurring_outside_income_monthly_totals_cents"] || payload["monthly_paycheck_totals_cents"]
- monthly_income = {} unless monthly_income.is_a?(Hash)
- excluded = payload["excluded_category_spending_cents"]
- excluded = {} unless excluded.is_a?(Hash)
- unresolved = payload["unresolved_transactions"]
- unresolved = {} unless unresolved.is_a?(Hash)

%div{ class: "ui-page" }
  %div{ class: "flex flex-wrap items-start justify-between gap-6" }
    %div
      = link_to "← Budget Proposals", budget_proposals_path, class: "ui-link text-sm"
      %h1{ class: "ui-title mt-3" }= @proposal.month.strftime("%B %Y")
      %p{ class: "mt-2 text-stone-700" }
        Budget proposal ·
        = budget_proposal_status_badge(@proposal, validation: @validation)
    - if @proposal.applied?
      = link_to "View Budget", budget_month_path(month: @proposal.budget_month.month.strftime("%Y-%m")), class: "ui-button-primary"

  - if @budget_month && !@proposal.applied?
    %div{ class: "ui-card ui-card-warning mt-6 text-sm", role: "alert" }
      %strong= "#{@proposal.month.strftime('%B %Y')} already has a budget."
      %p{ class: "mt-1 text-stone-700" }
        Replacing it will update only the category assignments and planned savings. Historical transactions and account data will not change.
      = link_to "View Existing Budget", budget_month_path(month: @budget_month.month.strftime("%Y-%m")), class: "ui-link mt-3 inline-block"

    %section#budget-comparison{ class: "ui-section mt-6" }
      %h2{ class: "text-lg font-semibold" } Existing budget compared with this proposal
      %div{ class: "ui-table-wrap mt-3" }
        %table{ class: "ui-table" }
          %thead
            %tr{ class: "border-b border-stone-200 bg-stone-50" }
              %th{ class: "p-3 text-left" }
              %th{ class: "p-3 text-right" } Existing budget
              %th{ class: "p-3 text-right" } Proposal
          %tbody
            %tr{ class: "border-t border-stone-200" }
              %th{ class: "p-3 text-left font-medium" } Total income
              %td{ class: "p-3 text-right" }= number_to_currency(@budget_comparison.existing_income_cents / 100.0)
              %td{ class: "p-3 text-right" }= number_to_currency(@budget_comparison.proposal_income_cents / 100.0)
            %tr{ class: "border-t border-stone-200" }
              %th{ class: "p-3 text-left font-medium" } Total spending
              %td{ class: "p-3 text-right" }= number_to_currency(@budget_comparison.existing_spending_cents / 100.0)
              %td{ class: "p-3 text-right" }= number_to_currency(@budget_comparison.proposal_spending_cents / 100.0)
            %tr{ class: "border-t border-stone-200" }
              %th{ class: "p-3 text-left font-medium" } Planned savings
              %td{ class: "p-3 text-right" }= number_to_currency(@budget_comparison.existing_savings_cents / 100.0)
              %td{ class: "p-3 text-right" }= number_to_currency(@budget_comparison.proposal_savings_cents / 100.0)
            %tr{ class: "border-t border-stone-200" }
              %th{ class: "p-3 text-left font-medium" } Savings rate
              %td{ class: "p-3 text-right" }= number_to_percentage(@budget_comparison.existing_savings_rate, precision: 1)
              %td{ class: "p-3 text-right" }= number_to_percentage(@budget_comparison.proposal_savings_rate, precision: 1)

      - if @budget_comparison.category_changes.any?
        %h3{ class: "mt-5 font-semibold" } Category assignment changes
        %div{ class: "ui-table-wrap mt-3" }
          %table{ class: "ui-table" }
            %thead
              %tr{ class: "border-b border-stone-200 bg-stone-50" }
                %th{ class: "p-3 text-left" } Category
                %th{ class: "p-3 text-right" } Existing
                %th{ class: "p-3 text-right" } Proposal
            %tbody
              - @budget_comparison.category_changes.each do |change|
                %tr{ class: "border-t border-stone-200" }
                  %td{ class: "p-3 font-medium" }= change.category_name
                  %td{ class: "p-3 text-right" }= number_to_currency(change.existing_cents / 100.0)
                  %td{ class: "p-3 text-right" }= number_to_currency(change.proposal_cents / 100.0)

  %div{ class: "mt-8 grid grid-cols-2 gap-4 lg:grid-cols-5" }
    %div{ class: "ui-card ui-card-positive" }
      %div{ class: "ui-summary-label" } Proposed income
      %div{ class: "ui-summary-value text-emerald-800" }= number_to_currency(@proposal.proposed_income_cents / 100.0)
    %div{ class: "ui-card" }
      %div{ class: "ui-summary-label" } Proposed spending
      %div{ class: "ui-summary-value" }= number_to_currency(@proposal.proposed_expense_cents / 100.0)
    %div#planned-savings-summary{ class: "ui-card ui-card-positive" }
      %div{ class: "ui-summary-label" } Planned savings
      %div{ class: "ui-summary-value text-emerald-800" }= number_to_currency(@proposal.proposed_savings_cents / 100.0)
    %div#savings-rate-summary{ class: "ui-card ui-card-positive" }
      %div{ class: "ui-summary-label" } Savings rate
      %div{ class: "ui-summary-value text-emerald-800" }= number_to_percentage(@proposal.savings_rate_percentage, precision: 1)
    %div#additional-savings-summary{ class: "ui-card border-sky-200 bg-sky-50/60" }
      %div{ class: "ui-summary-label" } AI potential savings
      - if @ai_savings_recommendations.any?
        %div{ class: "ui-summary-value text-sky-800" }= number_to_currency(@additional_potential_monthly_cents / 100.0)
        %div{ class: "text-xs text-stone-600" } per month · advisory only
      - else
        %div{ class: "mt-2 text-sm font-medium text-stone-600" } Not generated

  %div{ class: "ui-card mt-4 text-sm" }
    %div{ class: "flex flex-wrap gap-x-8 gap-y-2" }
      %div
        %span{ class: "text-stone-600" } Status:
        = budget_proposal_status_badge(@proposal, validation: @validation)
      %div
        %span{ class: "text-stone-600" } Income basis:
        %strong= payload.fetch("planning_baseline", "Not recorded").to_s.humanize
      %div
        %span{ class: "text-stone-600" } Total assigned:
        %strong= number_to_currency(@proposal.total_assigned_cents / 100.0)
      %div
        %span{ class: "text-stone-600" } Generated:
        %strong= @proposal.created_at.strftime("%B %-d, %Y at %-I:%M %p")

  %section{ class: "ui-section mt-8 border-t-emerald-300" }
    %h2{ class: "ui-section-title" } Income
    %p{ class: "mt-2 text-sm text-stone-700" }
      Available income is the arithmetic mean of the six explicit monthly paycheck totals before the proposal month. Paychecks are identified through active income sources.

    - if monthly_income.present?
      %div{ class: "mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" }
        - monthly_income.each do |month, cents|
          %div{ class: "border border-stone-200 bg-stone-50/70 p-3" }
            %div{ class: "text-xs text-stone-600" }= budget_proposal_month_label(month)
            %div{ class: "mt-1 font-medium" }= number_to_currency(cents.to_i / 100.0)
      %p{ class: "mt-3 text-sm" }
        Six-month paycheck average:
        %strong= number_to_currency(payload.fetch("paycheck_income_six_month_average_cents", @proposal.proposed_income_cents).to_i / 100.0)

  %section{ class: "ui-section mt-8" }
    %div{ class: "flex items-end justify-between" }
      %h2{ class: "ui-section-title" } Proposed Budget
      %div{ class: "text-sm text-stone-600" }= "#{@proposal.proposed_categories.length} categories"

    %div{ class: "ui-table-wrap mt-3" }
      %table{ class: "ui-table min-w-max" }
        %thead
          %tr{ class: "border-b border-stone-200 bg-stone-50" }
            %th{ class: "p-3 text-left" } Category
            %th{ class: "p-3 text-left" } Basis
            %th{ class: "p-3 text-right" } 3-month avg.
            %th{ class: "p-3 text-right" } 6-month avg.
            %th{ class: "p-3 text-right" } 12-month avg.
            %th{ class: "p-3 text-right" } Proposed
        %tbody
          - @proposal.proposed_categories.each do |row|
            - averages = row.fetch("average_spending_cents", {})
            %tr{ class: "border-t border-stone-200" }
              %td{ class: "p-3 font-medium" }= row.fetch("category_name", "Category ##{row['category_id']}")
              %td{ class: "p-3 text-stone-700" }= budget_proposal_rationale(row)
              %td{ class: "p-3 text-right text-stone-700" }= number_to_currency(averages.fetch("3", 0).to_i / 100.0)
              %td{ class: "p-3 text-right text-stone-700" }= number_to_currency(averages.fetch("6", 0).to_i / 100.0)
              %td{ class: "p-3 text-right text-stone-700" }= number_to_currency(averages.fetch("12", 0).to_i / 100.0)
              %td{ class: "p-3 text-right font-semibold" }= number_to_currency(row.fetch("proposed_cents", 0).to_i / 100.0)

  %section#savings{ class: "ui-section mt-8 border-t-emerald-400 bg-emerald-50/30" }
    %h2{ class: "ui-section-title text-emerald-900" } Savings
    %p{ class: "mt-2 text-sm text-stone-700" }
      Planned savings are part of this proposal and are included in its totals.

    %div{ class: "mt-4 border border-emerald-200 bg-white" }
      %dl{ class: "divide-y divide-stone-200 text-sm" }
        %div{ class: "flex items-center justify-between gap-6 p-3" }
          %dt{ class: "text-stone-700" } Available paycheck income
          %dd{ class: "font-medium" }= number_to_currency(@proposal.proposed_income_cents / 100.0)
        %div{ class: "flex items-center justify-between gap-6 p-3" }
          %dt{ class: "text-stone-700" } Total proposed spending
          %dd{ class: "font-medium" }= number_to_currency(@proposal.proposed_expense_cents / 100.0)
        %div{ class: "flex items-center justify-between gap-6 p-3" }
          %dt{ class: "text-stone-700" } Planned savings
          %dd{ class: "ui-money-positive" }= number_to_currency(@proposal.proposed_savings_cents / 100.0)
        %div{ class: "flex items-center justify-between gap-6 p-3" }
          %dt{ class: "text-stone-700" } Savings rate
          %dd{ class: "font-medium" }= number_to_percentage(@proposal.savings_rate_percentage, precision: 1)
        %div#unassigned-amount{ class: "flex items-center justify-between gap-6 p-3" }
          %dt{ class: "text-stone-700" } Unassigned
          %dd{ class: "font-medium" }= number_to_currency(@proposal.amount_remaining_cents / 100.0)

    - if @proposal.planned_savings_allocations.any?
      %div{ class: "mt-6" }
        %h3{ class: "font-semibold" } Planned savings
        %ul{ class: "mt-3 space-y-2 text-sm" }
          - @proposal.planned_savings_allocations.each do |allocation|
            %li{ class: "flex items-center justify-between gap-6 border-b border-stone-100 pb-2" }
              %span= allocation.fetch("name", "Savings")
              %strong= number_to_currency(allocation.fetch("proposed_cents", 0).to_i / 100.0)
        %div{ class: "mt-3 flex items-center justify-between gap-6 text-sm" }
          %span Total planned savings
          %strong{ class: "text-emerald-800" }= number_to_currency(@proposal.planned_savings_allocations_total_cents / 100.0)

  %section#ai-savings-suggestions{ class: "ui-section mt-8 border-t-sky-300 bg-sky-50/30" }
    %h2{ class: "ui-section-title text-sky-950" } AI savings suggestions
    %p{ class: "mt-2 text-sm text-stone-700" }
      These suggestions are stored with the proposal for review. They are advisory and never change proposal amounts automatically.

    - if @ai_savings_recommendations.any?
      %div{ class: "mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2" }
        %div{ class: "border border-sky-200 bg-white p-4" }
          %div{ class: "ui-summary-label" } Estimated potential savings
          %div{ class: "mt-1 text-xl font-semibold" }= "#{number_to_currency(@additional_potential_monthly_cents / 100.0)} / month"
        %div{ class: "border border-sky-200 bg-white p-4" }
          %div{ class: "ui-summary-label" } Estimated potential savings
          %div{ class: "mt-1 text-xl font-semibold" }= "#{number_to_currency(@additional_potential_annual_cents / 100.0)} / year"

      %div{ class: "mt-4 space-y-4" }
        - @ai_savings_recommendations.each do |recommendation|
          %article{ class: "border border-sky-200 bg-white p-4 shadow-sm" }
            %div{ class: "flex flex-wrap items-start justify-between gap-3" }
              %div
                %h3{ class: "font-semibold text-stone-950" }= recommendation.fetch("title")
                - if recommendation["category_or_merchant"].present?
                  %div{ class: "mt-1 text-sm text-stone-600" }= recommendation.fetch("category_or_merchant")
              = status_badge("#{recommendation.fetch('confidence').to_s.humanize} confidence", tone: :neutral)
            %p{ class: "mt-3 text-sm text-stone-700" }= recommendation.fetch("explanation")
            %dl{ class: "mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4" }
              %div
                %dt{ class: "text-stone-500" } Current spending
                %dd{ class: "mt-1 font-medium tabular-nums" }= number_to_currency(recommendation.fetch("current_spending_cents").to_i / 100.0)
              %div
                %dt{ class: "text-stone-500" } Suggested target
                %dd{ class: "mt-1 font-medium tabular-nums" }= number_to_currency(recommendation.fetch("suggested_target_cents").to_i / 100.0)
              %div
                %dt{ class: "text-stone-500" } Estimated monthly savings
                %dd{ class: "mt-1 font-medium tabular-nums text-sky-800" }= number_to_currency(recommendation.fetch("estimated_monthly_savings_cents").to_i / 100.0)
              %div
                %dt{ class: "text-stone-500" } Estimated annual savings
                %dd{ class: "mt-1 font-medium tabular-nums text-sky-800" }= number_to_currency(recommendation.fetch("estimated_annual_savings_cents").to_i / 100.0)
            %div{ class: "mt-4 border-t border-stone-200 pt-3" }
              %div{ class: "text-xs font-semibold uppercase tracking-wide text-stone-500" } Supporting evidence
              %ul{ class: "mt-2 list-disc space-y-1 pl-5 text-sm text-stone-700" }
                - recommendation.fetch("supporting_evidence").each do |evidence|
                  %li= evidence
    - else
      %p{ class: "mt-4 border border-stone-200 bg-white p-4 text-sm text-stone-600" }
        No savings suggestions have been generated for this proposal yet.

  - warning_items = @validation.errors + @validation.warnings
  - uncategorized_cents = excluded.fetch("Uncategorized", 0).to_i
  - credit_card_cents = excluded.fetch("Credit Card Payments", 0).to_i
  - if warning_items.any? || uncategorized_cents.positive? || credit_card_cents.positive? || unresolved.fetch("count", 0).to_i.positive?
    %section{ class: "ui-card ui-card-warning mt-8", role: "alert" }
      %h2{ class: "text-lg font-semibold" } Warnings
      %ul{ class: "mt-3 list-disc space-y-1 pl-5 text-sm" }
        - if uncategorized_cents.positive?
          %li= "Excluded Uncategorized spending: #{number_to_currency(uncategorized_cents / 100.0)}"
        - if credit_card_cents.positive?
          %li= "Excluded Credit Card Payments: #{number_to_currency(credit_card_cents / 100.0)}"
        - if unresolved.fetch("count", 0).to_i.positive?
          %li= "#{unresolved.fetch('count').to_i} unresolved transactions totaling #{number_to_currency(unresolved.fetch('amount_cents', 0).to_i / 100.0)} may affect this proposal."
        - warning_items.each do |warning|
          %li= warning

  - unless @proposal.applied?
    %div{ class: "mt-8 flex flex-wrap items-center gap-3 border-t-2 border-stone-300 bg-white p-5 shadow-sm" }
      - if @validation.valid?
        - if @budget_month
          = button_to "Replace Existing Budget",
            approve_budget_proposal_path(@proposal),
            method: :post,
            params: { replace_existing: "1" },
            form: { data: { turbo_confirm: "Replace the existing #{@proposal.month.strftime('%B %Y')} budget with this proposal?\n\nThis will replace the current #{@proposal.month.strftime('%B %Y')} category assignments with the amounts from this proposal. Historical transactions will not be changed." } },
            class: "ui-button-danger"
        - else
          = button_to "Approve and Create Budget",
            approve_budget_proposal_path(@proposal),
            method: :post,
            form: { data: { turbo_confirm: "Approve this proposal and create the #{@proposal.month.strftime('%B %Y')} budget?" } },
            class: "ui-button-primary"
      = button_to "Delete Proposal",
        budget_proposal_path(@proposal),
        method: :delete,
        form: { data: { turbo_confirm: "Delete this draft budget proposal?" } },
        class: "ui-button-danger-outline"
