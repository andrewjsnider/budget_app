%div{ class: "ui-page-wide" }
  %div{ class: "ui-page-header" }
    %div
      %h1{ class: "ui-title" } Budget Proposals
      %p{ class: "ui-subtitle" } Review generated budgets before approving them.
    = link_to "Back to Budget", budget_path, class: "ui-button-secondary"

  - if @proposals.empty?
    %div{ class: "ui-card mt-8 text-stone-700" }
      No budget proposals have been generated yet.
  - else
    %div{ class: "ui-table-wrap mt-8" }
      %table{ class: "ui-table min-w-max" }
        %thead
          %tr{ class: "border-b border-stone-200 bg-stone-50" }
            %th{ class: "p-3 text-left" } Month
            %th{ class: "p-3 text-left" } Created
            %th{ class: "p-3 text-left" } Status
            %th{ class: "p-3 text-right" } Proposed income
            %th{ class: "p-3 text-right" } Proposed spending
            %th{ class: "p-3 text-right" } Proposed savings
            %th{ class: "p-3 text-right" } Total assigned
            %th{ class: "p-3 text-left" } Actual budget
            %th{ class: "p-3 text-right" } Action
        %tbody
          - @proposals.each do |proposal|
            - existing_budget = proposal.budget_month || @budget_months_by_month[proposal.month]
            %tr{ class: "border-t border-stone-200" }
              %td{ class: "font-medium" }= proposal.month.strftime("%B %Y")
              %td{ class: "ui-cell-date" }= proposal.created_at.strftime("%b %-d, %Y %-I:%M %p")
              %td= budget_proposal_status_badge(proposal)
              %td{ class: "ui-cell-number" }= number_to_currency(proposal.proposed_income_cents / 100.0)
              %td{ class: "ui-cell-number" }= number_to_currency(proposal.proposed_expense_cents / 100.0)
              %td{ class: "ui-cell-number ui-money-positive" }= number_to_currency(proposal.proposed_savings_cents / 100.0)
              %td{ class: "ui-cell-number font-medium" }= number_to_currency(proposal.total_assigned_cents / 100.0)
              %td
                - if existing_budget
                  = link_to "Yes — View", budget_month_path(month: existing_budget.month.strftime("%Y-%m")), class: "ui-link"
                - else
                  %span{ class: "text-stone-600" } No
              %td{ class: "ui-cell-action" }
                = link_to "View", budget_proposal_path(proposal), class: "ui-button-secondary min-h-0 px-3 py-1.5"
