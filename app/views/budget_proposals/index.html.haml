%div{ class: "max-w-7xl mx-auto px-6 py-10 text-stone-900" }
  %div{ class: "flex items-end justify-between gap-6" }
    %div
      %h1{ class: "text-3xl font-semibold" } Budget Proposals
      %p{ class: "mt-2 text-stone-700" } Review generated budgets before approving them.
    = link_to "Back to Budget", budget_path, class: "text-sm underline hover:text-stone-600"

  - if @proposals.empty?
    %div{ class: "mt-8 border border-stone-200 p-6 text-stone-700" }
      No budget proposals have been generated yet.
  - else
    %div{ class: "mt-8 overflow-x-auto border border-stone-200" }
      %table{ class: "w-full min-w-max text-sm" }
        %thead
          %tr{ class: "border-b border-stone-200 bg-stone-50" }
            %th{ class: "p-3 text-left" } Month
            %th{ class: "p-3 text-left" } Created
            %th{ class: "p-3 text-left" } Status
            %th{ class: "p-3 text-right" } Proposed income
            %th{ class: "p-3 text-right" } Proposed spending
            %th{ class: "p-3 text-right" } Proposed savings
            %th{ class: "p-3 text-right" } Total assigned
            %th{ class: "p-3 text-left" } Actual budget
            %th{ class: "p-3 text-right" } Action
        %tbody
          - @proposals.each do |proposal|
            - existing_budget = proposal.budget_month || @budget_months_by_month[proposal.month]
            %tr{ class: "border-t border-stone-200" }
              %td{ class: "p-3 font-medium" }= proposal.month.strftime("%B %Y")
              %td{ class: "p-3 text-stone-700" }= proposal.created_at.strftime("%b %-d, %Y %-I:%M %p")
              %td{ class: "p-3" }= budget_proposal_status(proposal)
              %td{ class: "p-3 text-right" }= number_to_currency(proposal.proposed_income_cents / 100.0)
              %td{ class: "p-3 text-right" }= number_to_currency(proposal.proposed_expense_cents / 100.0)
              %td{ class: "p-3 text-right" }= number_to_currency(proposal.proposed_savings_cents / 100.0)
              %td{ class: "p-3 text-right font-medium" }= number_to_currency(proposal.total_assigned_cents / 100.0)
              %td{ class: "p-3" }
                - if existing_budget
                  = link_to "Yes — View", budget_month_path(month: existing_budget.month.strftime("%Y-%m")), class: "underline"
                - else
                  %span{ class: "text-stone-600" } No
              %td{ class: "p-3 text-right" }
                = link_to "View", budget_proposal_path(proposal), class: "underline font-medium"
