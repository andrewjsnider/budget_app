%div{ class: "ui-page" }
  %div{ class: "flex flex-col items-start justify-between gap-6 md:flex-row md:items-end" }
    %div
      %h1{ class: "ui-title" } Utilities
      %p{ class: "ui-subtitle" } Utility spending, composition, and trends

    = form_with url: reports_utilities_path, method: :get, class: "flex flex-wrap items-end gap-2 border border-stone-200 bg-white p-3 shadow-sm" do |f|
      %div
        %label{ class: "ui-label", for: "from" } From
        = month_field_tag :from, @from.strftime("%Y-%m"), class: "mt-1"
      %div
        %label{ class: "ui-label", for: "to" } To
        = month_field_tag :to, @to.strftime("%Y-%m"), class: "mt-1"
      = f.submit "Update", class: "ui-button-secondary"

  - if @report.categories.empty?
    %div{ class: "ui-card mt-10 text-stone-700" }
      No utility categories found. Add categories with group = utilities.
  - else
    - highest_month = @report.highest_month
    - highest_category = @report.highest_category

    %section{ class: "mt-8 grid grid-cols-1 gap-px border border-stone-200 bg-stone-200 sm:grid-cols-2 lg:grid-cols-4" }
      %div{ class: "bg-emerald-50/50 p-4" }
        %div{ class: "text-sm text-stone-600" } Latest month
        %div{ class: "mt-1 text-xl font-semibold" }= number_to_currency(@report.latest_month_cents / 100.0)
        %div{ class: "mt-1 text-xs text-stone-500" }= @report.latest_month&.strftime("%B %Y") || "No month selected"
      %div{ class: "bg-stone-50 p-4" }
        %div{ class: "text-sm text-stone-600" } Monthly average
        %div{ class: "mt-1 text-xl font-semibold" }= number_to_currency(@report.average_monthly_cents / 100.0)
        %div{ class: "mt-1 text-xs text-stone-500" } Across the selected range
      %div{ class: "bg-white p-4" }
        %div{ class: "text-sm text-stone-600" }= @report.period_label
        %div{ class: "mt-1 text-xl font-semibold" }= number_to_currency(@report.current_period_cents / 100.0)
        %div{ class: "mt-1 text-xs text-stone-500" }= "#{@from.strftime('%b %Y')}–#{@to.strftime('%b %Y')}"
      %div{ class: "bg-stone-50 p-4" }
        %div{ class: "text-sm text-stone-600" } Same period last year
        %div{ class: "mt-1 text-xl font-semibold" }= number_to_currency(@report.previous_period_cents / 100.0)
        %div{ class: "mt-1 text-xs text-stone-500" }= "#{@report.comparison_from.strftime('%b %Y')}–#{@report.comparison_to.strftime('%b %Y')}"
      %div{ class: "bg-white p-4" }
        %div{ class: "text-sm text-stone-600" } Year-over-year change
        %div{ class: "mt-1 text-xl font-semibold #{expense_change_class(@report.year_over_year_change_cents)}" }= signed_currency(@report.year_over_year_change_cents)
        - if @report.year_over_year_change_percentage
          %div{ class: "mt-1 text-xs text-stone-500" }= number_to_percentage(@report.year_over_year_change_percentage, precision: 1)
        - else
          %div{ class: "mt-1 text-xs text-stone-500" } No percentage — prior period is $0
      %div{ class: "bg-white p-4" }
        %div{ class: "text-sm text-stone-600" } Highest month
        %div{ class: "mt-1 text-xl font-semibold" }= number_to_currency((highest_month&.last || 0) / 100.0)
        %div{ class: "mt-1 text-xs text-stone-500" }= highest_month&.first&.strftime("%B %Y") || "No month selected"
      %div{ class: "bg-white p-4" }
        %div{ class: "text-sm text-stone-600" } Largest utility
        %div{ class: "mt-1 text-xl font-semibold" }= number_to_currency((highest_category&.last || 0) / 100.0)
        %div{ class: "mt-1 text-xs text-stone-500" }= highest_category&.first&.name || "No utility spending"

    - if @report.yearly_totals_cents.length > 1
      %section{ class: "mt-4 flex flex-wrap items-center gap-x-8 gap-y-3 border border-stone-200 px-4 py-3" }
        %h2{ class: "text-sm font-semibold" } Yearly totals in selected range
        - @report.yearly_totals_cents.each do |year, cents|
          %div{ class: "text-sm" }
            %span{ class: "text-stone-500" }= year
            %span{ class: "ml-2 font-medium" }= number_to_currency(cents / 100.0)

    %section{ class: "mt-10" }
      %h2{ class: "text-xl font-semibold" } Monthly utility spending
      %p{ class: "mt-1 text-sm text-stone-600" } Total utility spend for each month in the selected range
      %div{ class: "mt-4 border border-stone-200 bg-stone-50/50 p-4 shadow-sm" }
        = line_chart @report.monthly_totals_chart, height: "320px", prefix: "$", thousands: ",", colors: ["#047857"], curve: false, points: false, library: { plugins: { legend: { display: false } } }

    %section{ class: "mt-10" }
      %h2{ class: "text-xl font-semibold" } Year-over-year comparison
      %p{ class: "mt-1 text-sm text-stone-600" } The selected months aligned with the same months one year earlier
      %div{ class: "mt-4 border border-stone-200 bg-stone-50/50 p-4 shadow-sm" }
        = line_chart @report.year_over_year_chart, height: "320px", prefix: "$", thousands: ",", colors: ["#047857", "#a8a29e"], curve: false, points: false, library: { plugins: { legend: { position: "bottom" } } }

    %section{ class: "mt-10" }
      %h2{ class: "text-xl font-semibold" } Spending by utility over time
      %p{ class: "mt-1 text-sm text-stone-600" } Monthly totals split across utility categories
      %div{ class: "mt-4 border border-stone-200 bg-stone-50/50 p-4 shadow-sm" }
        = column_chart @report.monthly_by_category_chart, stacked: true, height: "360px", prefix: "$", thousands: ",", colors: ["#047857", "#b45309", "#0369a1", "#7c3aed", "#78716c", "#be123c"], library: { plugins: { legend: { position: "bottom" } } }

    %section{ class: "mt-10" }
      %h2{ class: "text-xl font-semibold" } Utility breakdown
      %p{ class: "mt-1 text-sm text-stone-600" } Total spending by category, largest first
      %div{ class: "mt-4 border border-stone-200 bg-stone-50/50 p-4 shadow-sm" }
        = bar_chart @report.totals_by_category_chart, height: "#{[@report.categories.length * 48, 240].max}px", prefix: "$", thousands: ",", colors: ["#047857", "#b45309", "#0369a1", "#7c3aed", "#78716c", "#be123c"], legend: false

    %section{ class: "mt-10" }
      %h2{ class: "text-xl font-semibold" } By utility
      %p{ class: "mt-1 text-sm text-stone-600" } Recent amount, average, and month-over-month direction
      %div{ class: "mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2" }
        - @report.category_trends.each do |trend|
          %article{ class: "border border-stone-200 bg-white p-4 shadow-sm" }
            %h3{ class: "font-semibold" }= trend.category.name
            %div{ class: "mt-3 grid grid-cols-3 gap-4 text-sm" }
              %div
                %div{ class: "text-stone-500" } Latest
                %div{ class: "mt-1 font-medium" }= number_to_currency(trend.latest_cents / 100.0)
              %div
                %div{ class: "text-stone-500" } Monthly average
                %div{ class: "mt-1 font-medium" }= number_to_currency(trend.average_cents / 100.0)
              %div
                %div{ class: "text-stone-500" } Previous month
                - if trend.previous_cents.nil?
                  %div{ class: "mt-1 text-stone-500" } Not available
                - elsif trend.new_this_month?
                  %div{ class: "mt-1 font-medium" } New this month
                  %div{ class: "text-xs text-stone-500" }= signed_currency(trend.change_cents)
                - elsif trend.previous_cents.zero?
                  %div{ class: "mt-1 font-medium #{expense_change_class(trend.change_cents)}" }= signed_currency(trend.change_cents)
                  %div{ class: "text-xs text-stone-500" } No prior spend
                - else
                  %div{ class: "mt-1 font-medium #{expense_change_class(trend.change_cents)}" }= signed_currency(trend.change_cents)
                  %div{ class: "text-xs text-stone-500" }= number_to_percentage(trend.change_percentage, precision: 1)
            %div{ class: "mt-4 grid grid-cols-3 gap-4 border-t border-stone-200 pt-3 text-sm" }
              %div
                %div{ class: "text-stone-500" } Selected period
                %div{ class: "mt-1 font-medium" }= number_to_currency(trend.current_period_cents / 100.0)
              %div
                %div{ class: "text-stone-500" } Same period last year
                %div{ class: "mt-1 font-medium" }= number_to_currency(trend.previous_period_cents / 100.0)
              %div
                %div{ class: "text-stone-500" } YoY change
                %div{ class: "mt-1 font-medium #{expense_change_class(trend.year_over_year_change_cents)}" }= signed_currency(trend.year_over_year_change_cents)
                - if trend.year_over_year_change_percentage
                  %div{ class: "text-xs text-stone-500" }= number_to_percentage(trend.year_over_year_change_percentage, precision: 1)
                - else
                  %div{ class: "text-xs text-stone-500" } No prior spend
            %div{ class: "mt-3" }
              = line_chart @report.trend_chart(trend), height: "72px", prefix: "$", thousands: ",", colors: ["#78716c"], curve: false, points: false, library: { plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { display: false } } }

    %section{ class: "mt-10" }
      %h2{ class: "text-xl font-semibold" } Monthly detail
      %div{ class: "ui-table-wrap mt-4" }
        %table{ class: "ui-table" }
          %thead
            %tr{ class: "border-b border-stone-200" }
              %th{ class: "p-3 text-left" } Month
              - @report.categories.each do |category|
                %th{ class: "p-3 text-right" }= category.name
              %th{ class: "p-3 text-right" } Total
          %tbody
            - @report.months.each do |month|
              %tr{ class: "border-t border-stone-200" }
                %td{ class: "p-3" }= month.strftime("%Y-%m")
                - @report.categories.each do |category|
                  %td{ class: "p-3 text-right" }= number_to_currency(@report.spending_cents(month, category) / 100.0)
                %td{ class: "p-3 text-right font-semibold" }= number_to_currency(@report.monthly_totals_cents.fetch(month) / 100.0)
