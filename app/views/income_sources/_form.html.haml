- if flash[:alert].present?
  %div{ class: "ui-card ui-card-danger mb-4 text-sm", role: "alert" }= flash[:alert]

= form_with model: income_source, data: { turbo: false }, class: "space-y-4" do |f|
  %div
    = f.label :name, class: "ui-label"
    = f.text_field :name, placeholder: "Job A or Side business", class: "mt-1 w-full"
  %div
    = f.label :kind, class: "ui-label"
    = f.text_field :kind, placeholder: "W-2, 1099, business", class: "mt-1 w-full"
  %div
    = f.label :account_id, "Account", class: "ui-label"
    = f.collection_select :account_id, @accounts, :id, :name, { prompt: "Choose an account" }, { class: "mt-1 w-full" }
  %div
    = f.label :category_id, "Income category", class: "ui-label"
    = f.collection_select :category_id, @income_categories, :id, :name, { prompt: "Choose an income category" }, { class: "mt-1 w-full" }

  %label{ class: "inline-flex items-center gap-2 text-sm text-stone-700" }
    = f.check_box :active
    Active

  = f.submit class: "ui-button-primary"
