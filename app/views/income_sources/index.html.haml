%div{ class: "ui-page" }
  %div{ class: "ui-page-header" }
    %h1{ class: "ui-title" } Income sources
    = link_to "New income source", new_income_source_path, class: "ui-button-primary"

  %div{ class: "ui-table-wrap mt-6" }
    %table{ class: "ui-table" }
      %thead
        %tr{ class: "border-b border-stone-200" }
          %th{ class: "p-3 text-left" } Name
          %th{ class: "p-3 text-left" } Kind
          %th{ class: "p-3 text-left" } Account
          %th{ class: "p-3 text-left" } Category
          %th{ class: "p-3 text-left" } Status
          %th{ class: "p-3 text-right" }
      %tbody
        - @income_sources.each do |s|
          %tr{ class: "border-t border-stone-200" }
            %td{ class: "font-medium" }= s.name
            %td= status_badge(s.kind.to_s.humanize, tone: :positive)
            %td{ class: "text-stone-600" }= s.account&.name
            %td{ class: "text-stone-600" }= s.category&.name
            %td= status_badge(s.active? ? "Active" : "Inactive", tone: s.active? ? :positive : :neutral)
            %td{ class: "ui-cell-action whitespace-nowrap" }
              = link_to "Edit", edit_income_source_path(s), class: "ui-link text-sm"
              %span{ class: "mx-2 text-stone-400" } |
              = link_to "Pay schedule", income_source_income_estimates_path(s), class: "ui-link text-sm"
