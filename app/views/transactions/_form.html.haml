- if flash[:alert].present?
  %div{ class: "ui-card ui-card-danger mb-4 text-sm", role: "alert" }= flash[:alert]

= form_with model: transaction, data: { turbo: false }, local: true, class: "space-y-4" do |f|
  %div
    = f.label :occurred_on, "Date", class: "ui-label"
    = f.date_field :occurred_on, class: "mt-1 w-full"
  %div
    = f.label :description, class: "ui-label"
    = f.text_field :description, placeholder: "Merchant or description", class: "mt-1 w-full"
  %div
    = f.label :account_id, "Account", class: "ui-label"
    = f.collection_select :account_id, @accounts, :id, :name, { prompt: "Choose an account" }, { class: "mt-1 w-full" }
  %div
    = f.label :category_id, "Category", class: "ui-label"
    = f.collection_select :category_id, @categories, :id, :name, { prompt: "Choose a category" }, { class: "mt-1 w-full" }
  %div
    = f.label :amount_cents, "Amount in cents", class: "ui-label"
    = f.text_field :amount_cents, placeholder: "Expense -1299, income 50000", class: "mt-1 w-full", inputmode: "numeric"
    %p{ class: "ui-help" } Use a negative amount for spending and a positive amount for income.
  = f.submit class: "ui-button-primary"
