%div{ class: "max-w-7xl mx-auto px-6 py-10 text-stone-900" }
  %div{ class: "flex items-end justify-between gap-6" }
    %div
      %h1{ class: "text-3xl font-semibold" } Transactions
      %p{ class: "mt-2 text-stone-700" }= @month.strftime("%B %Y")

    = link_to "New", new_transaction_path, class: "border border-stone-900 px-4 py-2 text-sm hover:bg-stone-900 hover:text-white"

  - if flash[:notice].present?
    %div{ class: "mt-6 border border-stone-300 p-3 text-sm" }= flash[:notice]

  = form_with url: transactions_path, method: :get, class: "mt-6 border border-stone-200 bg-stone-50 p-4" do
    - if @transaction_sort.present?
      = hidden_field_tag :sort, @transaction_sort
      = hidden_field_tag :direction, @transaction_direction

    %div{ class: "flex flex-wrap items-end gap-3" }
      %div{ class: "min-w-64 flex-1" }
        %label{ for: "q", class: "block text-sm font-medium text-stone-800" } Search
        = search_field_tag :q, @filter_values[:q], placeholder: "Search transactions...", class: "mt-1 w-full border border-stone-400 bg-white p-2 text-sm"
      %div
        %label{ for: "month", class: "block text-sm text-stone-700" } Month
        = month_field_tag :month, @month.strftime("%Y-%m"), class: "mt-1 border border-stone-300 bg-white p-2 text-sm"
      %div
        %label{ for: "account_id", class: "block text-sm text-stone-700" } Account
        = select_tag :account_id, options_from_collection_for_select(@accounts, :id, :name, @filter_values[:account_id]), include_blank: "All accounts", class: "mt-1 border border-stone-300 bg-white p-2 text-sm"
      %div
        %label{ for: "category_id", class: "block text-sm text-stone-700" } Category
        = select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, @filter_values[:category_id]), include_blank: "All categories", class: "mt-1 border border-stone-300 bg-white p-2 text-sm"

    %div{ class: "mt-3 flex flex-wrap items-end gap-3" }
      %div
        %label{ for: "start_date", class: "block text-sm text-stone-700" } Start date
        = date_field_tag :start_date, @filter_values[:start_date], class: "mt-1 border border-stone-300 bg-white p-2 text-sm"
      %div
        %label{ for: "end_date", class: "block text-sm text-stone-700" } End date
        = date_field_tag :end_date, @filter_values[:end_date], class: "mt-1 border border-stone-300 bg-white p-2 text-sm"
      %div
        %label{ for: "flow", class: "block text-sm text-stone-700" } Flow
        = select_tag :flow, options_for_select([["All flows", ""], ["Inflows", "inflow"], ["Outflows", "outflow"]], @filter_values[:flow]), class: "mt-1 border border-stone-300 bg-white p-2 text-sm"
      %div
        %label{ for: "reconciliation_status", class: "block text-sm text-stone-700" } Reconciliation
        = select_tag :reconciliation_status, options_for_select([["Any status", ""], ["Reconciled", "reconciled"], ["Unreconciled", "unreconciled"]], @filter_values[:reconciliation_status]), class: "mt-1 border border-stone-300 bg-white p-2 text-sm"
      %div
        %label{ for: "cleared_status", class: "block text-sm text-stone-700" } Cleared
        = select_tag :cleared_status, options_for_select([["Any status", ""], ["Cleared", "cleared"], ["Uncleared", "uncleared"]], @filter_values[:cleared_status]), class: "mt-1 border border-stone-300 bg-white p-2 text-sm"
      = submit_tag "Apply", class: "border border-stone-900 px-4 py-2 text-sm hover:bg-stone-900 hover:text-white"
      - if @filters_active
        = link_to "Clear filters", transactions_path, class: "px-2 py-2 text-sm underline"

  %div{ class: "mt-5 flex items-center justify-between" }
    %p{ class: "text-sm text-stone-700" }= pluralize(@transactions.length, "matching transaction")

  %div{ class: "mt-3 overflow-x-auto border border-stone-200" }
    %table{ class: "w-full text-sm" }
      %thead
        %tr{ class: "border-b border-stone-200" }
          %th{ class: "p-3 text-left", aria: { sort: sortable_header_aria_sort(key: "date", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Date", key: "date", default_direction: "desc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "p-3 text-left", aria: { sort: sortable_header_aria_sort(key: "description", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Description", key: "description", default_direction: "asc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "p-3 text-left", aria: { sort: sortable_header_aria_sort(key: "account", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Account", key: "account", default_direction: "asc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "p-3 text-left", aria: { sort: sortable_header_aria_sort(key: "category", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Category", key: "category", default_direction: "asc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "p-3 text-right", aria: { sort: sortable_header_aria_sort(key: "amount", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Amount", key: "amount", default_direction: "desc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "p-3 text-right" }
      %tbody
        - if @transactions.empty?
          %tr
            %td{ colspan: 6, class: "p-8 text-center text-stone-600" } No transactions match these filters.
        - else
          - @transactions.each do |t|
            = render "row", t: t, categories: @categories
