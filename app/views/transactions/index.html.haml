%div{ class: "ui-page-wide" }
  %div{ class: "ui-page-header" }
    %div
      %h1{ class: "ui-title" } Transactions
      %p{ class: "ui-subtitle" }= @month.strftime("%B %Y")

    = link_to "New transaction", new_transaction_path, class: "ui-button-primary"

  - if flash[:notice].present?
    %div{ class: "ui-card ui-card-positive mt-6 text-sm", role: "status" }= flash[:notice]

  = form_with url: transactions_path, method: :get, class: "mt-6 border border-stone-200 bg-stone-100/70 p-4 shadow-sm" do
    - if @transaction_sort.present?
      = hidden_field_tag :sort, @transaction_sort
      = hidden_field_tag :direction, @transaction_direction

    %div{ class: "flex flex-wrap items-end gap-3" }
      %div{ class: "min-w-64 flex-1" }
        %label{ for: "q", class: "ui-label" } Search
        = search_field_tag :q, @filter_values[:q], placeholder: "Search transactions...", class: "mt-1 w-full"
      %div
        %label{ for: "month", class: "ui-label" } Month
        = month_field_tag :month, @month.strftime("%Y-%m"), class: "mt-1"
      %div
        %label{ for: "account_id", class: "ui-label" } Account
        = select_tag :account_id, options_from_collection_for_select(@accounts, :id, :name, @filter_values[:account_id]), include_blank: "All accounts", class: "mt-1"
      %div
        %label{ for: "category_id", class: "ui-label" } Category
        = select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, @filter_values[:category_id]), include_blank: "All categories", class: "mt-1"

    %div{ class: "mt-3 flex flex-wrap items-end gap-3" }
      %div
        %label{ for: "start_date", class: "ui-label" } Start date
        = date_field_tag :start_date, @filter_values[:start_date], class: "mt-1"
      %div
        %label{ for: "end_date", class: "ui-label" } End date
        = date_field_tag :end_date, @filter_values[:end_date], class: "mt-1"
      %div
        %label{ for: "flow", class: "ui-label" } Flow
        = select_tag :flow, options_for_select([["All flows", ""], ["Inflows", "inflow"], ["Outflows", "outflow"]], @filter_values[:flow]), class: "mt-1"
      %div
        %label{ for: "reconciliation_status", class: "ui-label" } Reconciliation
        = select_tag :reconciliation_status, options_for_select([["Any status", ""], ["Reconciled", "reconciled"], ["Unreconciled", "unreconciled"]], @filter_values[:reconciliation_status]), class: "mt-1"
      %div
        %label{ for: "cleared_status", class: "ui-label" } Cleared
        = select_tag :cleared_status, options_for_select([["Any status", ""], ["Cleared", "cleared"], ["Uncleared", "uncleared"]], @filter_values[:cleared_status]), class: "mt-1"
      = submit_tag "Apply filters", class: "ui-button-primary"
      - if @filters_active
        = link_to "Clear filters", transactions_path, class: "ui-button-secondary"

  %div{ class: "mt-5 flex items-center justify-between" }
    %p{ class: "text-sm text-stone-700" }= pluralize(@transactions.length, "matching transaction")

  %div{ class: "ui-table-wrap mt-3" }
    %table{ class: "ui-table" }
      %thead
        %tr{ class: "border-b border-stone-200" }
          %th{ class: "text-left", aria: { sort: sortable_header_aria_sort(key: "date", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Date", key: "date", default_direction: "desc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "text-left", aria: { sort: sortable_header_aria_sort(key: "description", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Description", key: "description", default_direction: "asc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "text-left", aria: { sort: sortable_header_aria_sort(key: "account", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Account", key: "account", default_direction: "asc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "text-left", aria: { sort: sortable_header_aria_sort(key: "category", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Category", key: "category", default_direction: "asc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "text-right", aria: { sort: sortable_header_aria_sort(key: "amount", current_sort: @transaction_sort, current_direction: @transaction_direction) } }
            = sortable_header_link "Amount", key: "amount", default_direction: "desc", current_sort: @transaction_sort, current_direction: @transaction_direction
          %th{ class: "ui-cell-action" } Action
      %tbody
        - if @transactions.empty?
          %tr
            %td{ colspan: 6, class: "p-8 text-center text-stone-600" } No transactions match these filters.
        - else
          - @transactions.each do |t|
            = render "row", t: t, categories: @categories
